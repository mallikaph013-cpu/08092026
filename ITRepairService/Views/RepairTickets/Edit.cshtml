@model ITRepairService.Models.RepairTicket

@{
    ViewData["Title"] = "Edit IT Service";
    var approverDepartments = ViewData["ApproverDepartments"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList
        ?? new Microsoft.AspNetCore.Mvc.Rendering.SelectList(Enumerable.Empty<string>());
    var approverUsers = ViewData["ApproverUsers"] as List<ITRepairService.Models.ApplicationUser>
        ?? new List<ITRepairService.Models.ApplicationUser>();
    var driveAccessDepartments = ViewData["DriveAccessDepartments"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList
        ?? new Microsoft.AspNetCore.Mvc.Rendering.SelectList(Enumerable.Empty<string>());
    var selectedApproverUserId = ViewData["SelectedApproverUserId"]?.ToString() ?? Model.ApproverUserId;
    var currentUserDisplayName = ViewData["CurrentUserDisplayName"]?.ToString()
        ?? User.Identity?.Name
        ?? string.Empty;
    var itSupportUsers = ViewData["ItSupportUsers"] as List<ITRepairService.Models.ApplicationUser>
        ?? new List<ITRepairService.Models.ApplicationUser>();
    var selectedItSupportUserId = ViewData["SelectedItSupportUserId"]?.ToString() ?? Model.AssignedItUserId;
    var requesterEditMode = ViewData["RequesterEditMode"] as bool? ?? false;
    var thirdApproverUsers = ViewData["ThirdApproverUsers"] as List<ITRepairService.Models.ApplicationUser>
        ?? new List<ITRepairService.Models.ApplicationUser>();
    var selectedThirdApproverUserId = ViewData["SelectedThirdApproverUserId"]?.ToString() ?? Model.ThirdApproverUserId;
    var isDriveAccessRepairType = Model.RepairType == ITRepairService.Models.RepairType.DriveAccessPermission;
    // Match the Create form: the device-type field is only shown for Hardware and Software.
    var isHardwareOrSoftwareRepairType = Model.RepairType == ITRepairService.Models.RepairType.Hardware
        || Model.RepairType == ITRepairService.Models.RepairType.Software;
    var additionalApprovalStatuses = ViewData["ApprovalStatuses"] as List<ITRepairService.Models.TicketStatus>
        ?? new List<ITRepairService.Models.TicketStatus>();
    var flowPrimaryStatus = ViewData["FlowPrimaryStatus"] is ITRepairService.Models.TicketStatus statusFromFlow
        ? statusFromFlow
        : Model.Status;
    var showInitialOpenStatus = ViewData["ShowInitialOpenStatus"] as bool? ?? false;
    var hasPriorStatusSteps = (ViewData["HasPriorStatusSteps"] as bool? ?? false) || additionalApprovalStatuses.Count > 0;
    var isCurrentStatusApproved = Model.Status == ITRepairService.Models.TicketStatus.Approved;
    var canSeeInProgress = User.IsInRole(ITRepairService.Models.AppRoles.Admin)
        || User.IsInRole(ITRepairService.Models.AppRoles.ITSupport);
    var canMarkCompleteByAssignee = ViewData["CanMarkCompleteByAssignee"] as bool? ?? false;
    var canEditStatus = User.IsInRole(ITRepairService.Models.AppRoles.Approve)
        || User.IsInRole(ITRepairService.Models.AppRoles.ITSupport)
        || User.IsInRole(ITRepairService.Models.AppRoles.Admin)
        || canMarkCompleteByAssignee;
    var assigneeCompleteOnlyMode = canMarkCompleteByAssignee && !User.IsInRole(ITRepairService.Models.AppRoles.Approve);
    var isApproveUser = User.IsInRole(ITRepairService.Models.AppRoles.Approve)
        && !User.IsInRole(ITRepairService.Models.AppRoles.ITSupport);
    var currentUserId = ViewData["CurrentUserId"]?.ToString() ?? string.Empty;
    var returnAction = ViewData["ReturnAction"]?.ToString() ?? "Index";
    var isCurrentUserAssignedIt = ViewData["IsCurrentUserAssignedIt"] as bool? ?? false;
    var currentUserDepartment = ViewData["CurrentUserDepartment"]?.ToString() ?? string.Empty;
    var isDxUser = !string.IsNullOrWhiteSpace(currentUserDepartment)
        && currentUserDepartment.Trim().Equals("DX", StringComparison.OrdinalIgnoreCase);

    // DX Final Approver (DxFinalApproverUserId): เมื่อ DX ผu้อนุมัติขั้นสุดท้ายเข้ามาแก้ไขรายการที่
    // สถานะ Complete / InProgress / Closed (งานอยู่ในขั้นดำเนิน/เสร็จ/ปิด) ช่อง "ผู้รับผิดชอบ (IT)"
    // จะเป็น read-only — ผู้รับผิดชอบงาน IT ไม่ควรเปลี่ยนเมื่องานผ่านไปสายแล้ว
    var isCurrentUserDxFinalApprover = !string.IsNullOrWhiteSpace(currentUserId)
        && !string.IsNullOrWhiteSpace(Model.DxFinalApproverUserId)
        && currentUserId == Model.DxFinalApproverUserId;
    var isItAssigneeReadonlyStatus = Model.Status == ITRepairService.Models.TicketStatus.Complete
        || Model.Status == ITRepairService.Models.TicketStatus.InProgress
        || Model.Status == ITRepairService.Models.TicketStatus.Closed;
    var isItAssigneeReadonly = isCurrentUserAssignedIt
        || (isCurrentUserDxFinalApprover && isItAssigneeReadonlyStatus);
    var canEditStatusByUser = ViewData["CanEditStatusByUser"] as bool? ?? true;
    var isApprovedOrBeyond = Model.Status == ITRepairService.Models.TicketStatus.Approved
        || Model.Status == ITRepairService.Models.TicketStatus.InProgress
        || Model.Status == ITRepairService.Models.TicketStatus.Complete
        || Model.Status == ITRepairService.Models.TicketStatus.Closed;
    var lockPrimaryStatusSelection = !assigneeCompleteOnlyMode && (hasPriorStatusSteps || !canEditStatusByUser);
    var originalTicketStatus = Model.Status;
    var isRequesterEditOpen = requesterEditMode && Model.Status == ITRepairService.Models.TicketStatus.Open;
    var isRequesterEditRejected = requesterEditMode && originalTicketStatus == ITRepairService.Models.TicketStatus.Rejected;
    var isRequesterEditLocked = requesterEditMode && Model.Status != ITRepairService.Models.TicketStatus.Open && !isRequesterEditRejected;
    var isNotRequesterAndOpen = !requesterEditMode
        && !string.IsNullOrWhiteSpace(currentUserId)
        && !string.IsNullOrWhiteSpace(Model.RequesterUserId)
        && currentUserId != Model.RequesterUserId
        && Model.Status == ITRepairService.Models.TicketStatus.Open;
    var isCurrentUserApproverStep1 = !string.IsNullOrWhiteSpace(Model.ApproverUserId)
        && Model.ApproverUserId == currentUserId
        && Model.Step == 1
        && string.IsNullOrWhiteSpace(Model.SecondApproverUserId);
    var isDifferentApproverStep1 = !string.IsNullOrWhiteSpace(Model.ApproverUserId)
        && Model.ApproverUserId != currentUserId
        && Model.Step == 1
        && string.IsNullOrWhiteSpace(Model.SecondApproverUserId);
    var isThirdPartyViewerStep2 = !string.IsNullOrWhiteSpace(Model.ApproverUserId)
        && !string.IsNullOrWhiteSpace(Model.SecondApproverUserId)
        && Model.Step == 2
        && Model.ApproverUserId != currentUserId
        && Model.SecondApproverUserId != currentUserId;
    var isNonDriveNextApproverLocked = !isDriveAccessRepairType
        && Model.ApprovalLevel == 1
        && !string.IsNullOrWhiteSpace(Model.NextApproverUserId)
        && !string.IsNullOrWhiteSpace(Model.AssignedItUserId);
    var isCurrentUserNextApproverLevel1 = !string.IsNullOrWhiteSpace(Model.NextApproverUserId)
        && Model.NextApproverUserId == currentUserId
        && Model.ApprovalLevel == 1
        && Model.Status == ITRepairService.Models.TicketStatus.Open;

    // ช่อง "ฝ่ายที่อนุมัติลำดับถัดไป" (NextApproverDepartment) เป็น read-only เมื่อ
    // ผู้ใช้ปัจจุบันไม่ใช่ผู้แจ้ง (CurrentUserId != RequesterUserId) — ฝ่ายดังกล่าวเป็น
    // ค่าที่ระบบกำหนด (ฝ่ายของผู้แจ้ง หรือ ฝ่ายที่ขอสิทธิ์ Drive) ผู้อนุมัติจึงเปลี่ยนเองไม่ได้
    var isNextApproverDepartmentReadOnly = !string.Equals(
        currentUserId?.Trim(),
        Model.RequesterUserId?.Trim(),
        StringComparison.Ordinal);

    // Save is only allowed while the current user has never pressed Approve on this ticket.
    // Once the user has approved, the Save button is rendered as a disabled button instead.
    var hasCurrentUserApproved = ViewData["HasCurrentUserApproved"] as bool? ?? false;
    var canSave = !hasCurrentUserApproved;

    // A pending approval-chain member who has not approved yet (e.g. the routed
    // NextApprover waiting on an already Approved level-1 ticket) must keep a
    // working Save button until they perform their own approval.
    var isPendingChainApprover = !string.IsNullOrWhiteSpace(currentUserId)
        && !hasCurrentUserApproved
        && Model.NextApproverUserId == currentUserId;

    // Lock saving when the ticket is already Approved at level 1 and the viewer
    // is not the DX final approver - only the DX final approver can act on it.
    // A pending NextApprover who never approved is still allowed to save/approve.
    // Exception: the assigned IT user (CurrentUserId == AssignedItUserId) must
    // always be able to Save their assigned ticket.
    var isApprovedLevel1LockedForViewer = Model.Status == ITRepairService.Models.TicketStatus.Approved
        && Model.ApprovalLevel == 1
        && !string.IsNullOrWhiteSpace(currentUserId)
        && currentUserId != Model.DxFinalApproverUserId
        && !isPendingChainApprover
        && !isCurrentUserAssignedIt;

    Model.Status = flowPrimaryStatus;

    string GetTicketStatusBaseDisplayName(ITRepairService.Models.TicketStatus status)
    {
        var displayAttribute = status.GetType()
            .GetField(status.ToString())?
            .GetCustomAttributes(typeof(System.ComponentModel.DataAnnotations.DisplayAttribute), false)
            .OfType<System.ComponentModel.DataAnnotations.DisplayAttribute>()
            .FirstOrDefault();

        return displayAttribute?.GetName() ?? status.ToString();
    }

    string GetTicketStatusTimelineDisplayName(ITRepairService.Models.TicketStatus status, ITRepairService.Models.TicketStatus? previousStatus = null)
    {
        var currentLabel = GetTicketStatusBaseDisplayName(status);
        if (!previousStatus.HasValue)
        {
            return currentLabel;
        }

        if (previousStatus.Value == status)
        {
            return $"{currentLabel} (Saved)";
        }

        return $"{GetTicketStatusBaseDisplayName(previousStatus.Value)} -> {currentLabel}";
    }

    string GetStatusBadgeClass(ITRepairService.Models.TicketStatus status)
    {
        return status switch
        {
            ITRepairService.Models.TicketStatus.Open => "bg-warning text-dark",
            ITRepairService.Models.TicketStatus.InProgress => "bg-info text-white",
            ITRepairService.Models.TicketStatus.Approved => "bg-success",
            ITRepairService.Models.TicketStatus.Rejected => "bg-danger",
            ITRepairService.Models.TicketStatus.Complete => "bg-primary",
            ITRepairService.Models.TicketStatus.Closed => "bg-secondary",
            ITRepairService.Models.TicketStatus.Deleted => "bg-secondary",
            _ => "bg-secondary"
        };
    }

    string GetStatusIcon(ITRepairService.Models.TicketStatus status)
    {
        return status switch
        {
            ITRepairService.Models.TicketStatus.Open => "fa-circle",
            ITRepairService.Models.TicketStatus.InProgress => "fa-spinner fa-pulse",
            ITRepairService.Models.TicketStatus.Approved => "fa-check-circle",
            ITRepairService.Models.TicketStatus.Rejected => "fa-times-circle",
            ITRepairService.Models.TicketStatus.Complete => "fa-check-double",
            ITRepairService.Models.TicketStatus.Closed => "fa-lock",
            ITRepairService.Models.TicketStatus.Deleted => "fa-trash",
            _ => "fa-question-circle"
        };
    }
}

<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #0d6efd 0%, #0099ff 100%);
        --card-shadow: 0 2px 16px rgba(0,0,0,0.08);
        --card-shadow-hover: 0 8px 32px rgba(0,0,0,0.12);
        --transition-base: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        --border-radius-lg: 16px;
        --border-radius-md: 12px;
    }

    .header-card {
        background: linear-gradient(135deg, #6366f1 0%, #6366f1 50%, #6366f1 100%);
        border: none;
        border-radius: var(--border-radius-lg);
        position: relative;
        overflow: hidden;
    }

    .header-card::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -50%;
        width: 100%;
        height: 100%;
        background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
        pointer-events: none;
    }

    .header-card::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, #ffd700, #ffed4a, #ffd700);
        background-size: 200% 100%;
        animation: shimmer 2s ease-in-out infinite;
    }

    @@keyframes shimmer {
        0%, 100% { background-position: 200% 0; }
        50% { background-position: -200% 0; }
    }

    .form-card {
        border: none;
        border-radius: var(--border-radius-lg);
        box-shadow: var(--card-shadow);
        transition: var(--transition-base);
    }

    .form-card:hover {
        box-shadow: var(--card-shadow-hover);
    }

    .form-card .card-body {
        padding: 2rem;
    }

    .form-label {
        font-weight: 600;
        font-size: 0.875rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #495057;
        margin-bottom: 0.5rem;
    }

    .form-control, .form-select {
        border: 2px solid #e9ecef;
        border-radius: var(--border-radius-md);
        padding: 0.65rem 1rem;
        transition: var(--transition-base);
        font-size: 0.95rem;
    }

    .form-control:focus, .form-select:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.15);
    }

    .form-control:read-only, .form-control:disabled, .form-select:disabled {
        background-color: #f8f9fa;
        border-color: #dee2e6;
        opacity: 0.85;
        cursor: not-allowed;
    }

    textarea.form-control {
        min-height: 100px;
        resize: vertical;
    }

    .form-text {
        font-size: 0.8rem;
        color: #6c757d;
        margin-top: 0.35rem;
    }

    .validation-summary-errors ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .alert {
        border: none;
        border-radius: var(--border-radius-md);
        padding: 1rem 1.25rem;
        animation: slideDown 0.3s ease-out;
    }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    .alert-info {
        background: linear-gradient(135deg, #e8f4fd, #d0ebff);
        color: #0c5460;
        border-left: 4px solid #0dcaf0;
    }

    .alert-warning {
        background: linear-gradient(135deg, #fff8e1, #fff3cd);
        color: #856404;
        border-left: 4px solid #e8d090;
    }

    .alert-danger {
        background: linear-gradient(135deg, #fce4ec, #f8d7da);
        color: #721c24;
        border-left: 4px solid #dc3545;
    }

    .btn {
        padding: 0.6rem 1.5rem;
        font-weight: 600;
        border-radius: var(--border-radius-md);
        transition: var(--transition-base);
        position: relative;
        overflow: hidden;
    }

    .btn::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        width: 0;
        height: 0;
        background: rgba(255,255,255,0.2);
        border-radius: 50%;
        transform: translate(-50%, -50%);
        transition: width 0.6s, height 0.6s;
    }

    .btn:active::after {
        width: 300px;
        height: 300px;
    }

    .btn-primary {
        background: linear-gradient(135deg, #6366f1, #818cf8);
        border: none;
        box-shadow: 0 4px 15px rgba(13, 110, 253, 0.3);
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(13, 110, 253, 0.4);
    }

    .btn-success {
        background: linear-gradient(135deg, #a0d4b0, #20c997);
        border: none;
        box-shadow: 0 4px 15px rgba(25, 135, 84, 0.3);
    }

    .btn-success:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(25, 135, 84, 0.4);
    }

    .btn-danger {
        background: linear-gradient(135deg, #e4606d, #dc3545);
        border: none;
        box-shadow: 0 4px 15px rgba(220, 53, 69, 0.3);
    }

    .btn-danger:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(220, 53, 69, 0.4);
    }

    .btn-secondary {
        background: linear-gradient(135deg, #b8c0c8, #b8c0c8);
        border: none;
    }

    .btn-secondary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(184, 192, 200, 0.3);
    }

    .btn-light {
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.3);
        color: white;
    }

    .btn-light:hover {
        background: rgba(255,255,255,0.25);
        color: white;
        transform: translateY(-2px);
    }

    .badge-status {
        font-size: 0.85rem;
        padding: 0.5em 1em;
        border-radius: 50px;
        font-weight: 500;
        letter-spacing: 0.02em;
        animation: fadeIn 0.3s ease-out;
    }

    .status-timeline {
        position: relative;
        padding-left: 2rem;
    }

    .status-timeline::before {
        content: '';
        position: absolute;
        left: 0.5rem;
        top: 0;
        bottom: 0;
        width: 2px;
        background: linear-gradient(to bottom, #0d6efd, #20c997);
    }

    .status-step-row {
        animation: slideDown 0.3s ease-out;
    }

    .reject-remark-container {
        animation: slideDown 0.4s ease-out;
    }

    .input-group .form-select:disabled {
        background-color: #f8f9fa;
    }

    .input-group .btn-outline-danger {
        border: 2px solid #dc3545;
        color: #dc3545;
        transition: var(--transition-base);
    }

    .input-group .btn-outline-danger:hover:not(:disabled) {
        background: #dc3545;
        color: white;
        transform: scale(1.05);
    }

    .input-group .btn-outline-danger:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }

    /* Select2-like enhanced select styling */
    select.form-select option {
        padding: 0.5rem;
    }

    /* Responsive tweaks */
    .form-row-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    @@media (max-width: 768px) {
        .form-row-grid {
            grid-template-columns: 1fr;
        }
        .form-card .card-body {
            padding: 1.25rem;
        }
    }

    /* Smooth hover reveal for hidden sections */
    .hidden-section {
        opacity: 0;
        max-height: 0;
        overflow: hidden;
        transition: all 0.4s ease-in-out;
    }

    .hidden-section.visible {
        opacity: 1;
        max-height: 500px;
    }

    /* Auto-route alert animation */
    #autoRouteAlert {
        animation: slideDown 0.5s ease-out;
        border-left: 4px solid #0dcaf0;
        background: linear-gradient(135deg, #e8f4fd, #d0ebff);
    }

    /* IT Assign field smooth toggle */
    #itAssignContainer,
    #itAssignContainerDx {
        transition: var(--transition-base);
    }

    /* Status display input */
    #statusDisplay {
        background: linear-gradient(135deg, #f8f9fa, #e9ecef);
        font-weight: 500;
    }

    /* Button group spacing */
    .btn-group-action {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    /* Alert Popup Styles */
    .alert-popup {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 9999;
        display: none;
    }

    .alert-popup.show {
        display: block;
    }

    .alert-popup-content {
        background: white;
        border-radius: var(--border-radius-lg);
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
        max-width: 500px;
        width: 90%;
        padding: 2rem;
    }

    .alert-popup-header {
        padding: 1.5rem 1.5rem 0.5rem;
        text-align: center;
    }

    .alert-popup-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: #495057;
        margin: 0.5rem 0 0;
    }

    .alert-popup-body {
        padding: 1rem 1.5rem 1.5rem;
        text-align: center;
    }

    .alert-popup-body p {
        color: #6c757d;
        font-size: 1rem;
        margin: 0;
    }

    .alert-popup-footer {
        padding: 1rem 1.5rem 1.5rem;
    }

    .alert-popup-footer .btn {
        width: 100%;
    }
</style>

<div class="row mb-4">
    <div class="col-12">
        <div class="card header-card text-white">
            <div class="card-body py-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h1 class="h2 fw-bold mb-1 d-flex align-items-center gap-2">
                        <i class="fas fa-pen-to-square"></i> Edit IT Service
                        <span class="badge rounded-pill bg-white text-primary fs-6 ms-2">@(string.IsNullOrWhiteSpace(Model.DocumentNo) ? $"#{Model.Id}" : Model.DocumentNo)</span>
                    </h1>
                    <p class="mb-0 opacity-90 d-flex align-items-center gap-2">
                        <i class="fas fa-info-circle"></i> Update IT repair request
                        <span class="badge badge-status @GetStatusBadgeClass(originalTicketStatus)">
                            <i class="fas @GetStatusIcon(originalTicketStatus) me-1"></i>
                            @GetTicketStatusBaseDisplayName(originalTicketStatus)
                        </span>
                    </p>
                </div>
                <a asp-action="@returnAction" class="btn btn-light fw-semibold px-4">
                    <i class="fas fa-arrow-left me-2"></i>Back to List
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card form-card">
            <div class="card-body">
                <form asp-action="Edit" id="editTicketForm">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CreatedAt" />
                    <input type="hidden" asp-for="Priority" />
                    @* Carry the originating list (MyTasks / Index / AssignedToMe) through the POST
                       so that after Save the user is returned to the page they came from. Without
                       this the POST action cannot know the source and defaults to Index. *@
                    <input type="hidden" name="returnAction" value="@returnAction" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3" style="display: none;" id="validationSummary"></div>

                    @if (requesterEditMode)
                    {
                        @if (originalTicketStatus == ITRepairService.Models.TicketStatus.Complete)
                        {
                            <div class="alert alert-info d-flex align-items-center gap-2">
                                <i class="fas fa-check-circle fa-lg"></i>
                                <span>IT ได้ดำเนินการเสร็จเรียบร้อยแล้ว กรุณากด <strong>Close</strong> เพื่อปิดงาน</span>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning d-flex align-items-center gap-2">
                                <i class="fas fa-rotate-left fa-lg"></i>
                                <span>เมื่อบันทึก ระบบจะส่งรายการกลับเป็นสถานะ <strong>Open</strong> อัตโนมัติ</span>
                            </div>
                        }
                    }

                    <div class="form-row-grid">
                        <div class="mb-3">
                            <label asp-for="RequesterName" class="form-label">
                                <i class="fas fa-user me-1"></i>ผู้แจ้งซ่อม
                            </label>
                            <input asp-for="RequesterName" class="form-control" readonly />
