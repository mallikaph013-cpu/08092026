                                                var flowIndexOfCurrentForSelect = System.Array.IndexOf(flowStatusesForSelect, originalTicketStatus);
                                                var isItSupportOnly = User.IsInRole(ITRepairService.Models.AppRoles.ITSupport)
                                                    && !User.IsInRole(ITRepairService.Models.AppRoles.Admin);

                                                for (var flowIdxSel = 0; flowIdxSel < flowStatusesForSelect.Length; flowIdxSel++)
                                                {
                                                    var statusVal = flowStatusesForSelect[flowIdxSel];
                                                    // ไม่แสดงสถานะที่ย้อนกลับไปก่อนสถานะปัจจุบัน (ห้ามถอยหลังใน flow)
                                                    if (flowIndexOfCurrentForSelect >= 0 && flowIdxSel < flowIndexOfCurrentForSelect)
                                                    {
                                                        continue;
                                                    }
                                                    // ITSupport ทั่วไป (ไม่ใช่ Admin) เปลี่ยนสถานะงานได้เฉพาะ InProgress และ Complete
                                                    if (isItSupportOnly
                                                        && statusVal != ITRepairService.Models.TicketStatus.InProgress
                                                        && statusVal != ITRepairService.Models.TicketStatus.Complete)
                                                    {
                                                        continue;
                                                    }
                                                    // กรณีสถานะเป็น Closed ให้แสดงเป็นแบบอ่านอย่างเดียว (ไม่ให้เลือกเปลี่ยน)
                                                    if (originalTicketStatus == ITRepairService.Models.TicketStatus.Closed)
                                                    {
                                                        continue;
                                                    }
                                                    var isSelected = originalTicketStatus == statusVal;

                                                    @if (isSelected)
                                                    {
                                                        <option value="@statusVal" selected>@GetTicketStatusTimelineDisplayName(statusVal)</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@statusVal">@GetTicketStatusTimelineDisplayName(statusVal)</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    }
                                </div>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                    }

                    <!-- Alert Popup -->
                    <div id="alertPopup" class="alert-popup">
                        <div class="alert-popup-content">
                            <div class="alert-popup-header">
                                <i class="fas fa-exclamation-circle text-warning fa-3x mb-3"></i>
                                <h5 class="alert-popup-title">แจ้งเตือน</h5>
                            </div>
                            <div class="alert-popup-body">
                                <p id="alertPopupMessage"></p>
                            </div>
                            <div class="alert-popup-footer d-flex gap-2">
                                <button type="button" class="btn btn-success flex-fill" id="alertPopupConfirm">Yes</button>
                                <button type="button" class="btn btn-danger flex-fill" id="alertPopupCancel">No</button>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex gap-3 flex-wrap">
                        @if (ViewData["IsClosedReadOnly"] as bool? ?? false)
                        {
                            <button type="button" class="btn btn-secondary px-5" disabled>
                                <i class="fas fa-lock me-2"></i>Closed
                            </button>
                        }
                        else if (isApprovedLevel1LockedForViewer)
                        {
                            <button type="button" class="btn btn-secondary px-5" disabled title="รายการได้รับการอนุมัติแล้ว รอผู้อนุมัติ DX ดำเนินการ">
                                <i class="fas fa-lock me-2"></i>Approved
                            </button>
                        }
                        else if (!canSave)
                        {
                            <button type="button" class="btn btn-secondary px-5" disabled
                                    title="คุณได้อนุมัติรายการนี้ไปแล้ว ไม่สามารถบันทึกซ้ำได้">
                                <i class="fas fa-lock me-2"></i>Save
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-primary px-5" id="saveBtn">
                                <i class="fas fa-save me-2"></i>Save
                            </button>
                        }
                        <a asp-action="@returnAction" class="btn btn-secondary px-4">
                            <i class="fas fa-times me-2"></i>Back to List
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        (function () {
            // Track if user clicked Approve button
            let hasClickedApprove = false;

            // Flag: current user is the assigned IT person (fields should be read-only)
            const isCurrentUserAssignedItJs = @(isCurrentUserAssignedIt ? "true" : "false");

            // Flag: DX final approver editing Complete/InProgress/Closed — IT assignee field is read-only
            const isItAssigneeReadonlyJs = @(isItAssigneeReadonly ? "true" : "false");

            // Drive Access first approver (Step 1, ApproverUserId ยังว่าง, NextApproverUserId ==
            // CurrentUserId): the controller already defaulted the "ฝ่ายที่อนุมัติลำดับถัดไป"
            // dropdown to the Drive-requesting department (DriveAccessDepartment) — see
            // isDriveAccessFirstApproverActing in RepairTicketsController.Edit (GET).
            const driveAccessFirstApproverDefaulting = @(ViewData["DriveAccessFirstApproverDefaulting"] as bool? ?? false ? "true" : "false");
            
            // DOM Elements
            const departmentSelect = document.getElementById('approverDepartmentSelect');
            const approverSelect = document.getElementById('approverUserSelect');
            const statusHidden = document.getElementById('statusHidden');
            const statusBadge = document.getElementById('statusBadge');
            const statusBadgeText = document.getElementById('statusBadgeText');
            const additionalStatusSteps = document.getElementById('additionalStatusSteps');
            const editForm = document.getElementById('editTicketForm')
                || document.querySelector('form[action*="Edit"]')
                || document.querySelector('form');
            const approveBtn = document.getElementById('approveBtn');
            const rejectBtn = document.getElementById('rejectBtn');
            const remarkContainer = document.getElementById('rejectRemarkContainer');
            const remarkContainerDx = document.getElementById('rejectRemarkContainerDx');
            const remarkInput = document.getElementById('rejectRemark');
            const remarkInputDx = document.getElementById('rejectRemarkDx');
            const itAssignContainer = document.getElementById('itAssignContainer');
            const itAssignSelect = document.getElementById('itAssignSelect');
            const saveBtn = document.getElementById('saveBtn');
            const alertPopup = document.getElementById('alertPopup');
            const alertPopupMessage = document.getElementById('alertPopupMessage');
            const alertPopupConfirm = document.getElementById('alertPopupConfirm');
            const alertPopupCancel = document.getElementById('alertPopupCancel');
            const directNextApproverSelectEl = document.getElementById('directNextApproverSelect');

            // Original (server-rendered) disabled state of the next-approver routing fields,
            // captured before any Reject/Approve click mutates them. The Reject handler
            // disables both fields to skip routing validation; switching back to Approve
            // must restore this original state (DX mode / locked selects stay disabled).
            const departmentSelectOriginallyDisabled = departmentSelect ? departmentSelect.disabled : false;
            const approverSelectOriginallyDisabled = approverSelect ? approverSelect.disabled : false;

            // คืนสถานะ enable/disable ของช่อง "ฝ่ายที่อนุมัติลำดับถัดไป" และ
            // "ผู้อนุมัติลำดับถัดไป" กลับไปเป็นค่าเริ่มต้นจาก server — ใช้เมื่อสลับ
            // จาก Reject กลับไปเป็น Approve เพื่อให้เลือกผู้อนุมัติลำดับถัดไปได้
            function restoreNextApproverFields() {
                if (departmentSelect) {
                    departmentSelect.disabled = departmentSelectOriginallyDisabled;
                }
                if (approverSelect) {
                    approverSelect.disabled = approverSelectOriginallyDisabled;
                }
            }

            // Validation summary auto-show
            const validationSummary = document.getElementById('validationSummary');
            if (validationSummary && validationSummary.querySelector('ul') && validationSummary.querySelector('ul').children.length > 0) {
                validationSummary.style.display = 'block';
            }

            // Status badge class map
            const statusBadgeClasses = {
                'Open': 'bg-warning text-dark',
                'InProgress': 'bg-info text-white',
                'Approved': 'bg-success',
                'Rejected': 'bg-danger',
                'Complete': 'bg-primary',
                'Closed': 'bg-secondary'
            };

            const statusIcons = {
                'Open': 'fa-circle',
                'InProgress': 'fa-spinner fa-pulse',
                'Approved': 'fa-check-circle',
                'Rejected': 'fa-times-circle',
                'Complete': 'fa-check-double',
                'Closed': 'fa-lock'
            };

            // Update status badge visual
            function updateStatusBadge(statusValue) {
                if (!statusBadge || !statusBadgeText) return;
                const displayText = statusValue === 'Approved' ? 'Approved (ผู้อนุมัติได้อนุมัติรายการ)' :
                                    statusValue === 'Rejected' ? 'Rejected (ผู้อนุมัติไม่อนุมัติรายการ)' :
                                    statusValue;
                statusBadgeText.textContent = displayText;
                // Update badge class
                Object.keys(statusBadgeClasses).forEach(key => {
                    const classes = statusBadgeClasses[key];
                    if (classes) {
                        classes.split(' ').forEach(cls => {
                            if (cls) statusBadge.classList.remove(cls);
                        });
                    }
                });
                const badgeClass = statusBadgeClasses[statusValue];
                if (badgeClass) {
                    badgeClass.split(' ').forEach(cls => {
                        if (cls) statusBadge.classList.add(cls);
                    });
                }
                // Update icon
                const icon = statusBadge.querySelector('i');
                if (icon) {
                    Object.values(statusIcons).forEach(cls => {
                        cls.split(' ').forEach(c => {
                            if (c) icon.classList.remove(c);
                        });
                    });
                    statusIcons[statusValue]?.split(' ').forEach(cls => {
                        if (cls) icon.classList.add(cls);
                    });
                }
            }

            // Initialize alert popup
            let isPopupShowing = false;
            let pendingPopupMessage = null;
            let pendingPopupOkOnly = false;

            function showAlertPopup(message, okOnly = false) {
                if (!alertPopup || !alertPopupMessage) return;

                // If popup is currently showing, queue the message
                if (isPopupShowing) {
                    pendingPopupMessage = message;
                    pendingPopupOkOnly = !!okOnly;
                    return;
                }

                // ปรับปุ่มของ popup ตามโหมด: ปกติ = Yes/No, okOnly = มีเฉพาะปุ่ม OK
                applyPopupButtons(okOnly);

                alertPopupMessage.textContent = message;
                isPopupShowing = true;
                alertPopup.classList.add('show');
            }

            // ตั้งค่าปุ่มของ popup: โหมดปกติแสดงปุ่ม Yes/No, โหมด okOnly แสดงเฉพาะปุ่ม OK
            function applyPopupButtons(okOnly) {
                if (alertPopupCancel) {
                    alertPopupCancel.style.display = okOnly ? 'none' : '';
                }
                if (alertPopupConfirm) {
                    alertPopupConfirm.textContent = okOnly ? 'OK' : 'Yes';
                }
            }

            function hideAlertPopup() {
                if (!alertPopup) return;
                
                alertPopup.classList.remove('show');
                isPopupShowing = false;

                // If there's a pending message, show it after a short delay
                if (pendingPopupMessage) {
                    const message = pendingPopupMessage;
                    const okOnly = pendingPopupOkOnly;
                    pendingPopupMessage = null;
                    pendingPopupOkOnly = false;
                    setTimeout(() => showAlertPopup(message, okOnly), 100);
                }
            }

            if (alertPopupConfirm) {
                alertPopupConfirm.addEventListener('click', hideAlertPopup);
            }
            if (alertPopupCancel) {
                alertPopupCancel.addEventListener('click', hideAlertPopup);
            }

            // showAlertModal: แสดง popup แจ้งเตือนที่มีเฉพาะปุ่ม OK (ไม่มีปุ่ม Yes/No)
            // ใช้กับข้อความ validation ที่ผู้ใช้แค่กดรับทราบ เช่น
            // "กรุณาเลือกผู้อนุมัติลำดับถัดไปก่อนอนุมัติ"
            const showAlertModal = (message) => showAlertPopup(message, true);

            // Approve/Reject button handlers
            function setApprovalStatus(status, isReject = false) {
                if (statusHidden) {
                    statusHidden.value = status;
                }
                updateStatusBadge(status);

                // Also update the visible status dropdown if it exists
                const statusDropdown = document.getElementById('statusDropdown');
                if (statusDropdown && status === 'Approved') {
                    statusDropdown.value = 'Approved';
                }

                if (isReject) {
                    if (remarkContainer) {
                        remarkContainer.style.display = 'block';
                    }
                    if (remarkContainerDx) {
                        remarkContainerDx.style.display = 'block';
                    }
                    if (remarkInput) {
                        remarkInput.required = true;
                    }
                    if (remarkInputDx) {
                        remarkInputDx.required = true;
                    }
                } else {
                    if (remarkContainer) {
                        remarkContainer.style.display = 'none';
                    }
                    if (remarkContainerDx) {
                        remarkContainerDx.style.display = 'none';
                    }
                    if (remarkInput) {
                        remarkInput.required = false;
                    }
                    if (remarkInputDx) {
                        remarkInputDx.required = false;
                    }
                }
            }

            if (approveBtn) {
                approveBtn.addEventListener('click', () => {
                    // Set flag to indicate user clicked Approve
                    hasClickedApprove = true;
                    
                    // Get current user info
                    const currentUserId = '@(ViewData["CurrentUserId"]?.ToString() ?? string.Empty)';
                    const currentUserDepartment = '@(ViewData["CurrentUserDepartment"]?.ToString() ?? string.Empty)';
                    const currentUserName = '@(ViewData["CurrentUserDisplayName"]?.ToString() ?? string.Empty)';
                    
                    // Get the repair type from the form
                    const repairTypeSelect = document.getElementById('RepairType');
                    const isDriveAccess = repairTypeSelect && repairTypeSelect.value === '@((int)ITRepairService.Models.RepairType.DriveAccessPermission)';
                    
                    // Get the second approver user ID (ThirdApproverUserId)
                    const thirdApproverSelect = document.getElementById('directNextApproverSelect');
                    const hasSecondApprover = thirdApproverSelect && thirdApproverSelect.value;
                    
                    // Check if NextApproverUserId has a value before allowing approval
                    // In DX mode, check directNextApproverSelect; otherwise check approverSelect
                    const isDxMode = directNextApproverSelectEl !== null;
                    const nextApproverSelect = isDxMode ? directNextApproverSelectEl : approverSelect;

                    // ไม่ต้องเช็ค showAlertModal('กรุณาเลือกผู้อนุมัติลำดับถัดไปก่อนอนุมัติ')
                    // ตอนกดปุ่ม Approve — ให้ผู้ใช้สลับมาเป็น Approve ได้อิสระ (เช่น หลังกด
                    // Reject ช่อง "ผู้อนุมัติลำดับถัดไป" ยังแก้ไขได้) เงื่อนไขนี้ถูกย้ายไป
                    // ตรวจตอนกด Save เท่านั้น (ดู saveBtn handler ด้านล่าง)
                    
                    // For Drive Access Permission: skip department/same-user validation if:
                    // - Repair type is Drive Access Permission
                    // - NextApproverUserId is not empty
                    // - ThirdApproverUserId is empty
                    // - OR if NextApproverUserId and NextApproverName are already set (not empty)
                    const nextApproverNameInput = document.querySelector('input[name="NextApproverName"]');
                    const hasNextApproverName = nextApproverNameInput && nextApproverNameInput.value;
                    const isDiffApproverStep1 = @(isDifferentApproverStep1 ? "true" : "false");
                    const skipValidation = isDriveAccess && (!hasSecondApprover || (hasNextApproverName && nextApproverSelect.value))
                        || isDiffApproverStep1;
                    
                    if (!skipValidation) {
                        // Check if current user is the same as the selected approver
                        // (null-safe: ช่องอาจไม่ถูกเรนเดอร์ในบาง branch เช่น readonly/hidden)
                        const selectedApproverId = nextApproverSelect ? nextApproverSelect.value : '';
                        
                        if (currentUserId && selectedApproverId && currentUserId === selectedApproverId) {
                            showAlertModal('กรุณาเปลี่ยนผู้อนุมัติลำดับถัดไปใหม่');
                            return;
                        }

                        // Check if Next Approver Department and Next Approver User are the same as current user
                        if (!isDxMode && departmentSelect && nextApproverSelect) {
                            const selectedDepartment = departmentSelect.value;
                            
                            if (currentUserDepartment && selectedDepartment && 
                                currentUserId && selectedApproverId &&
                                currentUserDepartment.toLowerCase() === selectedDepartment.toLowerCase() &&
                                currentUserId === selectedApproverId) {
                                showAlertPopup('⚠️ ไม่สามารถบันทึกรายการได้ กรุณาเลือกฝ่ายที่อนุมัติลำดับถัดไป และ ผู้อนุมัติลำดับถัดไปใหม่');
                                return;
                            }
                        }

                        // Check if current user's department matches the selected approver department (only in non-DX mode)
                        // Additional conditions: not IT department, and CurrentUserId != DxFinalApproverUserId
                        if (!isDxMode && departmentSelect) {
                            const selectedDepartment = departmentSelect.value;
                            const dxFinalApproverUserId = '@(Model.DxFinalApproverUserId?.ToString() ?? string.Empty)';
                            
                            if (currentUserDepartment && selectedDepartment && 
                                currentUserDepartment.toLowerCase() === selectedDepartment.toLowerCase() &&
                                currentUserDepartment.trim().toLowerCase() !== 'it' &&
                                currentUserId !== dxFinalApproverUserId) {
                                showAlertPopup('⚠️ ไม่สามารถบันทึกรายการได้ กรุณาเลือกฝ่ายที่อนุมัติลำดับถัดไป และ ผู้อนุมัติลำดับถัดไปใหม่');
                                return;
                            }
                        }
                    }

                    // Set approval status
                    setApprovalStatus('Approved', false);

                    // สลับจาก Reject กลับมาเป็น Approve: ช่อง "หมายเหตุการตีกลับ" ถูกซ่อน
                    // แล้วโดย setApprovalStatus ด้านบน ให้คืนช่อง "ฝ่าย/ผู้อนุมัติลำดับถัดไป"
                    // ที่ถูก disable ตอนกด Reject กลับมาแก้ไขได้เหมือนก่อนกด Reject
                    restoreNextApproverFields();
                    
                    // Update ApproverName hidden field with current user's name
                    // The controller will set ApproverUserId to current user when processing the approval
                    const approverNameHidden = document.querySelector('input[name="ApproverName"]');
                    if (approverNameHidden && currentUserName) {
                        approverNameHidden.value = currentUserName;
                    }
                    
                    // Note: SecondApproverUserId must NOT be set by the first approver (ApproverUserId).
                    // It is only set by the DX department approver in the controller.
                    
                    // For Drive Access Permission with second approver, show different message
                    if (isDriveAccess && hasSecondApprover) {
                        const autoRouteAlert = document.getElementById('autoRouteAlert');
                        if (autoRouteAlert) {
                            autoRouteAlert.innerHTML = '<i class="fas fa-info-circle me-1"></i>เมื่ออนุมัติ ระบบจะส่งงานไปยัง SM/DM ของฝ่าย DX อัตโนมัติ';
                            autoRouteAlert.style.display = 'block';
                        }
                    } else {
                        const autoRouteAlert = document.getElementById('autoRouteAlert');
                        if (autoRouteAlert) {
                            autoRouteAlert.style.display = 'none';
                        }
                    }

                    if (itAssignContainer && itAssignSelect) {
                        itAssignContainer.style.display = 'block';
                        // Don't re-enable if current user is the assigned IT person (read-only)
                        itAssignSelect.disabled = isCurrentUserAssignedItJs;
                    }
                    
                    // Disable Approve button after successful approval to prevent double click
                    approveBtn.disabled = true;
                    approveBtn.classList.remove('btn-success');
                    approveBtn.classList.add('btn-secondary');
                    approveBtn.innerHTML = '<i class="fas fa-check me-1"></i>Approved';
                    
                    // Show success message
                    showAlertPopup('✅ คุณได้อนุมัติรายการนี้แล้ว\n\nกรุณากดปุ่ม Save เพื่อบันทึกข้อมูล');
                });
            }

            if (rejectBtn) {
                rejectBtn.addEventListener('click', () => {
                    // When rejecting, set status to Rejected
                    setApprovalStatus('Rejected', true);
                    
                    // Skip validation for NextApprover fields when rejecting
                    // Disable the NextApproverDepartment and NextApproverUserId fields
                    // so they won't be validated or required
                    if (departmentSelect) {
                        departmentSelect.disabled = true;
                    }
                    if (approverSelect) {
                        approverSelect.disabled = true;
                    }
                });
            }

            // Approver department/user filter
            if (departmentSelect && approverSelect) {
                // Initialize after DOM is fully loaded
                const initApproverFilter = () => {
                    // Capture the originally selected option BEFORE any filtering
                    const originallySelectedOption = approverSelect.querySelector('option[selected]');
                    const originallySelectedUserId = originallySelectedOption ? originallySelectedOption.value : null;
                    const allApproverOptions = Array.from(approverSelect.querySelectorAll('option'))
                        .filter(option => option.value !== '');

                    // Sync department dropdown to match the selected approver's department.
                    // SKIPPED for Drive Access first approver (Step 1, ApproverUserId ยังว่าง,
                    // NextApproverUserId == CurrentUserId): the controller already defaulted
                    // the "ฝ่ายที่อนุมัติลำดับถัดไป" dropdown to the Drive-requesting department
                    // (DriveAccessDepartment) while the pre-selected approver is the first
                    // approver themselves (a different department). Syncing it back would wipe
                    // the default and force the user to re-select the department every time.
                    if (!driveAccessFirstApproverDefaulting) {
                        const selectedOption = allApproverOptions.find(opt => opt.value === originallySelectedUserId);
                        if (selectedOption) {
                            const selectedDept = selectedOption.getAttribute('data-department');
                            if (selectedDept && departmentSelect.value !== selectedDept) {
                                departmentSelect.value = selectedDept;
                            }
                        }
                    }

                    // Filter approver options based on the selected department
                    function renderApproverOptions() {
                        const selectedDepartment = departmentSelect.value;
                        const selectedUserId = originallySelectedUserId || approverSelect.getAttribute('data-selected-user-id');

                        approverSelect.innerHTML = '';
                        const placeholder = document.createElement('option');
                        placeholder.value = '';
                        placeholder.textContent = '— Select approver —';
                        approverSelect.appendChild(placeholder);

                        let foundSelected = false;

                        allApproverOptions.forEach(option => {
                            const department = option.getAttribute('data-department') || '';
                            const optionValue = option.value;

                            // Strict filter: only show users matching the selected department
                            if (selectedDepartment && department !== selectedDepartment) {
                                return;
                            }

                            const clonedOption = option.cloneNode(true);
                            // Preserve selection only if it matches the department filter
                            if (optionValue === selectedUserId && (!selectedDepartment || department === selectedDepartment)) {
                                clonedOption.selected = true;
                                foundSelected = true;
                            }

                            approverSelect.appendChild(clonedOption);
                        });

                        // If no department selected and user wasn't found, restore original selected user
                        if (!foundSelected && !selectedDepartment && selectedUserId) {
                            const originalOption = allApproverOptions.find(opt => opt.value === selectedUserId);
                            if (originalOption) {
                                const clonedOption = originalOption.cloneNode(true);
                                clonedOption.selected = true;
                                approverSelect.appendChild(clonedOption);
                            }
                        }
                    }

                    // When department changes, filter the approver list
                    departmentSelect.addEventListener('change', renderApproverOptions);

                    // When approver changes, update the department to match the selected approver's department
                    approverSelect.addEventListener('change', function() {
                        const selectedOption = this.options[this.selectedIndex];
                        const selectedDepartment = selectedOption ? selectedOption.getAttribute('data-department') : '';
                        if (selectedDepartment && departmentSelect) {
                            departmentSelect.value = selectedDepartment;
                        }
                    });

                    // Initial render
                    renderApproverOptions();
                };

                // Wait for DOM to be fully loaded
                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', initApproverFilter);
                } else {
                    initApproverFilter();
                }
            }

            // IT Assignee toggle
            function toggleItAssignField() {
                if (itAssignContainer && itAssignSelect && statusHidden) {
                    const isClosed = statusHidden.value === 'Closed';
                    const isInProgress = statusHidden.value === 'InProgress';
                    const isDxApprover = @(isDxUser ? "true" : "false");
                    const isApproved = statusHidden.value === 'Approved';
                    const isItOrAdmin = @(User.IsInRole(ITRepairService.Models.AppRoles.ITSupport) || User.IsInRole(ITRepairService.Models.AppRoles.Admin) ? "true" : "false");
                    const shouldShow = isItOrAdmin || isInProgress || (isDxApprover && isApproved) || isClosed;

                    itAssignContainer.style.display = shouldShow ? 'block' : 'none';
                    // Keep disabled when the field should be read-only (assigned IT themselves,
                    // DX final approver on Complete/InProgress/Closed, or status is Closed)
                    itAssignSelect.disabled = !shouldShow || isItAssigneeReadonlyJs || isClosed;
                    itAssignSelect.required = isInProgress && !isCurrentUserAssignedItJs;
                }
            }

            // Sync status dropdown with badge and hidden field
            const statusDropdown = document.getElementById('statusDropdown');
            const statusBadgeItAdmin = document.getElementById('statusBadgeItAdmin');
            const statusBadgeTextItAdmin = document.getElementById('statusBadgeTextItAdmin');
            if (statusDropdown && statusHidden) {
                statusDropdown.addEventListener('change', () => {
                    const newValue = statusDropdown.value;
                    statusHidden.value = newValue;
                    updateStatusBadge(newValue);
                    
                    // Update IT Admin badge
                    if (statusBadgeItAdmin && statusBadgeTextItAdmin) {
                        const displayText = newValue === 'Approved' ? 'Approved (ผู้อนุมัติได้อนุมัติรายการ)' :
                                            newValue === 'Rejected' ? 'Rejected (ผู้อนุมัติไม่อนุมัติรายการ)' :
                                            newValue;
                        statusBadgeTextItAdmin.textContent = displayText;
                        Object.keys(statusBadgeClasses).forEach(key => {
                            const classes = statusBadgeClasses[key];
                            if (classes) {
                                classes.split(' ').forEach(cls => {
                                    if (cls) statusBadgeItAdmin.classList.remove(cls);
                                });
                            }
                        });
                        const badgeClass = statusBadgeClasses[newValue];
                        if (badgeClass) {
                            badgeClass.split(' ').forEach(cls => {
                                if (cls) statusBadgeItAdmin.classList.add(cls);
                            });
                        }
                        const icon = statusBadgeItAdmin.querySelector('i');
                        if (icon) {
                            Object.values(statusIcons).forEach(cls => {
                                cls.split(' ').forEach(c => {
                                    if (c) icon.classList.remove(c);
                                });
                            });
                            statusIcons[newValue]?.split(' ').forEach(cls => {
                                if (cls) icon.classList.add(cls);
                            });
                        }
                    }
                    
                    // Show/hide reject remark container when status changes to/from Rejected
                    if (remarkContainer) {
                        remarkContainer.style.display = newValue === 'Rejected' ? 'block' : 'none';
                    }
                    if (remarkContainerDx) {
                        remarkContainerDx.style.display = newValue === 'Rejected' ? 'block' : 'none';
                    }
                    if (remarkInput) {
                        remarkInput.required = newValue === 'Rejected';
                    }
                    if (remarkInputDx) {
                        remarkInputDx.required = newValue === 'Rejected';
                    }

                    // จับคู่พฤติกรรมกับปุ่ม Approve/Reject: เมื่อเลือกสถานะ Rejected ผ่าน
                    // dropdown ให้ disable ช่องฝ่าย/ผู้อนุมัติลำดับถัดไปเหมือนกดปุ่ม Reject
                    // เมื่อเลือกสถานะอื่น ให้คืนสถานะตามค่าเริ่มต้นจาก server
                    if (newValue === 'Rejected') {
                        if (departmentSelect) {
                            departmentSelect.disabled = true;
                        }
                        if (approverSelect) {
                            approverSelect.disabled = true;
                        }
                    } else {
                        restoreNextApproverFields();
                    }
                });
            }

            // Save button: validate then submit directly (no confirmation popup)
            const requesterEditModeJs = @(requesterEditMode ? "true" : "false");
            const isDifferentApproverStep1Js = @(isDifferentApproverStep1 ? "true" : "false");
            // True when CurrentUserId has already pressed Approve on this ticket (persisted state).
            // In that case saving is not allowed anymore.
            const hasCurrentUserApprovedJs = @(hasCurrentUserApproved ? "true" : "false");

            if (saveBtn && hasCurrentUserApprovedJs) {
                saveBtn.disabled = true;
                saveBtn.classList.remove('btn-primary');
                saveBtn.classList.add('btn-secondary');
                saveBtn.title = 'คุณได้อนุมัติรายการนี้ไปแล้ว ไม่สามารถบันทึกซ้ำได้';
            }

            if (saveBtn) {
                saveBtn.addEventListener('click', function(e) {
                    // Block saving when the current user already approved this ticket
                    if (hasCurrentUserApprovedJs) {
                        e.preventDefault();
                        showAlertPopup('⚠️ คุณได้อนุมัติรายการนี้ไปแล้ว ไม่สามารถบันทึกซ้ำได้');
                        return false;
                    }

                    // Ensure the selected status from the dropdown is synced into the
                    // hidden Status field before validation & submission.
                    // The status dropdown itself has no name attribute, so it relies on
                    // this sync to send the chosen InProgress/Complete/... value.
                    const saveStatusDropdown = document.getElementById('statusDropdown');
                    if (saveStatusDropdown && statusHidden && saveStatusDropdown.value) {
                        statusHidden.value = saveStatusDropdown.value;
                    }

                    const currentStatus = statusHidden ? statusHidden.value : '';                    // Validate reject remark when status is Rejected
                    if (currentStatus === 'Rejected') {
                        const remarkValue = remarkInput ? remarkInput.value.trim() : '';
                        const remarkValueDx = remarkInputDx ? remarkInputDx.value.trim() : '';
                        if (!remarkValue && !remarkValueDx) {
                            e.preventDefault();
                            showAlertPopup('⚠️ กรุณาระบุหมายเหตุการตีกลับก่อนบันทึก');
                            return false;
                        }
                        // Allow submission for Rejected status
                        return true;
                    }

                    // ผู้อนุมัติลำดับถัดไป ต้องเลือกก่อนบันทึก — เช็คเฉพาะตอนกด Save
                    // (ย้ายมาจากปุ่ม Approve ตาม requirement): เมื่อช่อง "ผู้อนุมัติลำดับถัดไป"
                    // เป็น dropdown ที่แก้ไขได้ (เช่น First Approver ของรายการขอสิทธิ์ Drive
                    // ที่ต้อง route งานต่อ) ต้องเลือกผู้อนุมัติลำดับถัดไปก่อน จึงจะบันทึกได้
                    // — ช่องแบบ readonly/hidden, ช่องที่ถูก lock (disabled) และโหมด DX
                    // (บันทึกผ่าน DxFinalApproverUserId) ไม่อยู่ในเงื่อนไขนี้
                    if (approverSelect && !approverSelect.disabled && !approverSelect.value) {
                        e.preventDefault();
                        console.log('DEBUG: Blocked on save - No next approver selected');
                        showAlertModal('กรุณาเลือกผู้อนุมัติลำดับถัดไปก่อนอนุมัติ');
                        return false;
                    }

                    // Validate approver department and user before saving (only for non-DX mode)
                    const isDxMode = directNextApproverSelectEl !== null;

                    // In DX mode: a DX final approver must be selected before saving
                    if (isDxMode && !requesterEditModeJs) {
                        const selectedDxApprover = directNextApproverSelectEl ? directNextApproverSelectEl.value : '';
                        const hiddenDxField = document.getElementById('hiddenDxFinalApproverUserId');
                        const dxFinalValue = selectedDxApprover || (hiddenDxField ? hiddenDxField.value : '');

                        if (!dxFinalValue) {
                            e.preventDefault();
                            console.log('DEBUG: Blocked on save - No DX approver selected');
                            showAlertPopup('⚠️ ไม่สามารถบันทึกรายการได้ กรุณาเลือกผู้อนุมัติ DX');
                            return false;
                        }
                    }

                    if (!isDxMode && !requesterEditModeJs && !isDifferentApproverStep1Js) {
                        const currentUserId = '@(ViewData["CurrentUserId"]?.ToString() ?? string.Empty)';
                        const selectedApprover = approverSelect ? approverSelect.value : '';
                        // The value the ticket was routed with at creation (pre-filled dropdown).
                        const routedNextApproverId = (approverSelect && approverSelect.dataset && approverSelect.dataset.selectedUserId) || '';

                        // Block only genuine self-routing (actively changing the next approver to
                        // yourself). When the ticket was routed TO the current user (Drive Access
                        // first approver), the pre-filled value legitimately equals their own id
                        // and must be allowed to save.
                        const isRoutedSelf = !!(currentUserId && routedNextApproverId && currentUserId === routedNextApproverId);

                        if (selectedApprover && currentUserId && currentUserId === selectedApprover && !isRoutedSelf) {
                            e.preventDefault();
                            console.log('DEBUG: Blocked on save - Same user');
                            showAlertPopup('⚠️ ไม่สามารถบันทึกรายการได้ เนื่องจากผู้อนุมัติลำดับถัดไป');
                            return false;
                        }
                    }

                    // Show loading state and submit directly
                    e.preventDefault();
                    saveBtn.disabled = true;
                    saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span>Saving...';
                    editForm.submit();
                    return false;
                });
            }

            // Sync directNextApproverSelect to hiddenDxFinalApproverUserId field
            // Note: NextApproverDepartment is NOT synced with the DX approver selection
            // They are independent fields - the department stays as "DX" regardless of which DX approver is selected
            const hiddenDxFinalApproverUserId = document.getElementById('hiddenDxFinalApproverUserId');
            
            if (directNextApproverSelectEl && hiddenDxFinalApproverUserId) {
                // Update hidden field when dropdown changes
                directNextApproverSelectEl.addEventListener('change', function() {
                    hiddenDxFinalApproverUserId.value = this.value;
                });
                
                // Initial sync
                hiddenDxFinalApproverUserId.value = directNextApproverSelectEl.value;
            }

            // Initial toggle
            toggleItAssignField();

            // Always sync the status dropdown into the hidden Status field before the
            // form is submitted (covers Enter-key submits and any submit path that does
            // not go through the Save button click handler above).
            if (editForm && statusHidden) {
                editForm.addEventListener('submit', function () {
                    const submitStatusDropdown = document.getElementById('statusDropdown');
                    if (submitStatusDropdown && submitStatusDropdown.value) {
                        statusHidden.value = submitStatusDropdown.value;
                    }
                });
            }

            // PDF attachment: show the clear button only after a file is selected
            // (clears the newly chosen file only - the saved attachment stays untouched)
            const pdfAttachmentInput = document.getElementById('pdfAttachmentInput');
            const clearPdfAttachmentBtn = document.getElementById('clearPdfAttachmentBtn');

            if (pdfAttachmentInput && clearPdfAttachmentBtn) {
                pdfAttachmentInput.addEventListener('change', function () {
                    clearPdfAttachmentBtn.style.display = pdfAttachmentInput.files.length > 0 ? '' : 'none';
                });

                clearPdfAttachmentBtn.addEventListener('click', function () {
                    pdfAttachmentInput.value = '';
                    clearPdfAttachmentBtn.style.display = 'none';
                });
            }
        })();
    </script>
}
